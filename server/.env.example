# Copy to server/.env and fill in. Never commit server/.env.

NODE_ENV=development
PORT=4000

# MongoDB connection string (personal Atlas cluster or local MongoDB for development). SECRET.
MONGODB_URI=
# Allowed browser origin(s) for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Long random string used to sign admin session tokens. SECRET.
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET
CLOUDINARY_API_SECRET=
