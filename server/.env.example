# Copy to server/.env and fill in. Never commit server/.env.

NODE_ENV=development
PORT=4000

# MongoDB connection string (personal Atlas cluster or local MongoDB for development). SECRET.
MONGODB_URI=
# Allowed browser origin(s) for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Swagger UI at /api/docs. Leave empty for the default: on in development, off in production.
API_DOCS_ENABLED=
# Signs admin session tokens: at least 32 random characters. Required to start the API. SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudinary: signs dashboard uploads and runs upload-album. Leave empty to switch uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET
CLOUDINARY_API_SECRET=

# Email the PANS inbox about each new feedback message and alumni sign-up (both, or leave both
# empty to send none). GMAIL_USER is the Gmail account that sends, e.g. pansunilag@gmail.com.
# GMAIL_APP_PASSWORD is a Google app password for it (Google Account → Security → 2-Step
# Verification → App passwords), never the account's normal password. SECRET.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who receives them, comma-separated. Leave empty to send them to GMAIL_USER.
NOTIFY_EMAIL=
