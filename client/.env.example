# Copy to client/.env and fill in. Everything here is PUBLIC: it ends up in the browser bundle.
# Never put secrets in this file.

# Base URL of the API. In development the Vite proxy forwards /api to the server, so leave empty.
VITE_API_URL=
# Cloudinary cloud name (used to build image URLs)
VITE_CLOUDINARY_CLOUD_NAME=
# Public site URL, used for canonical links and previews
VITE_SITE_URL=http://localhost:5173
