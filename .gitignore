# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output (client: Vite, server: tsc)
dist/
build/

# testing
coverage/
playwright-report/
test-results/

# environment variables (never commit real secrets)
.env
.env*.local
!.env.example

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# hosting
.vercel
.netlify

# TypeScript
*.tsbuildinfo

# database dumps (never commit backups)
dump/
*.archive

# OS and editor files
.DS_Store
Thumbs.db
.idea/
*.swp
# event photos downloaded for upload (never commit originals)
photos/
